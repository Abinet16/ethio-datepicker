{
  "name": "@ethio-datepicker/core",
  "version": "0.0.0",
  "description": "Zero-dependency Ethiopian calendar core: conversion, leap years, arithmetic, formatting and month grids.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["ethiopian", "calendar", "ethiopic", "amharic", "date", "gregorian", "converter", "pagume"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": { "node": ">=18" }
}
